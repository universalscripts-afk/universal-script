local CONFIG_FILE_NAME = "UniversalFramework_Config.json"

local function saveConfig()
    local success, encoded = pcall(function()
        local serializable = {}
        for k, v in pairs(Config) do
            if typeof(v) == "EnumItem" then
                serializable[k] = {Type = "EnumItem", EnumType = tostring(v.EnumType), Name = v.Name}
            elseif typeof(v) ~= "Instance" and typeof(v) ~= "function" then
                serializable[k] = v
            end
        end
        return HttpService:JSONEncode(serializable)
    end)
    if success and writefile then
        pcall(function() writefile(CONFIG_FILE_NAME, encoded) end)
    end
end

local function loadConfig()
    if readfile and isfile and isfile(CONFIG_FILE_NAME) then
        local success, decoded = pcall(function()
            return HttpService:JSONDecode(readfile(CONFIG_FILE_NAME))
        end)
        if success and type(decoded) == "table" then
            for k, v in pairs(decoded) do
                if Config[k] ~= nil then
                    if type(v) == "table" and v.Type == "EnumItem" then
                        pcall(function()
                            Config[k] = Enum[v.EnumType][v.Name]
                        end)
                    else
                        Config[k] = v
                    end
                end
            end
        end
    end
    Config.TargetPartName = "Head"
end

